  "tracker": {
    "chapter": "Chapter 07 · Automations",
    "goal": "Test it by hand, put it on the clock, and earn the Seal of Tidewheel",
    "next": "Every Seal is yours, Master Captain. These waters are yours to sail."
  },
  "quests": [
    {
      "id": "Q7.1",
      "title": "Programming the Sequencer",
      "task": "Hear the Bard’s tale",
      "steps": {
        "start": "Lyra’s playing on the Bandstand, along the lane from the quay.",
        "done": "A producer programs a pattern once and lets it run. The pattern is the saved prompt."
      }
    },
    {
      "id": "Q7.2",
      "title": "The Four Gears",
      "task": "Learn what an automation is made of",
      "steps": {
        "start": "Keeper Agnes is on Gear Square, up the first flight of the Lamp Stair.",
        "done": "A trigger, a prompt, tools, and a review path. Start manual and local, with a read-only report."
      }
    },
    {
      "id": "Q7.3",
      "title": "The Bounty Board",
      "task": "Confirm that work items exist",
      "link": {
        "label": "Check your pull requests in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/07-automations/README.md#confirm-work-items-exist"
      },
      "steps": {
        "start": "Tobin keeps the bounty board, up the second flight.",
        "done": "At least three open pull requests, in whatever state they are in now."
      }
    },
    {
      "id": "Q7.4",
      "title": "The Lever",
      "task": "Create a manual report, run it, and read its run",
      "link": {
        "label": "Create the automation in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/07-automations/README.md#exercise-create-a-manual-review-readiness-report"
      },
      "steps": {
        "start": "Ansel is in the Wheel Works, up the stair from Bounty Corner.",
        "lever": "Work the Lever round the Wheel Works.",
        "solved": "Every lamp in the Works is lit. Talk to Ansel.",
        "done": "Manual, local, and read-only. Create and run, then read the run: the prompt, no errors, and a table with a next action."
      }
    },
    {
      "id": "Q7.5",
      "title": "Gears & Bells",
      "task": "Schedule the report, and know what it needs",
      "link": {
        "label": "Schedule the automation in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/07-automations/README.md#exercise-schedule-the-review-readiness-report"
      },
      "steps": {
        "start": "Greta keeps the Clock Court, along the Clock Walk.",
        "clock": "Work Gears & Bells round the Clock Court.",
        "solved": "Every lamp in the court is lit. Talk to Greta.",
        "done": "Daily at 08:00, and no other hour. A local run needs the computer awake and the app running."
      }
    },
    {
      "id": "Q7.6",
      "title": "The Trial of the Long Light",
      "task": "Pass the Trial to earn the last Seal",
      "steps": {
        "start": "Old Silas waits on the Lighthouse’s terrace, up the Light Walk.",
        "exam": "The Trial of the Long Light is ready when you are.",
        "done": "The Seal of Tidewheel is yours, and the last light is lit."
      }
    },
    {
      "id": "Q7.O",
      "title": "Bells and the Rock Light",
      "task": "Hear about event triggers and the cloud",
      "optional": true,
      "link": {
        "label": "Read the optional section ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/07-automations/README.md#event-triggers"
      },
      "steps": {
        "start": "Nerys is by the Bell Arch, in the Clock Court.",
        "done": "Twelve event triggers. Start read-only and filter narrowly. Cloud runs on GitHub, in private or internal repositories."
      }
    },
    {
      "id": "Q7.A",
      "title": "Your Turn: One Manual Automation",
      "task": "Automate one task of your own",
      "optional": true,
      "link": {
        "label": "Do the assignment in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/07-automations/README.md#assignment"
      },
      "steps": {
        "start": "Silas has one more task, on the terrace.",
        "try": "Create and run your own manual automation in the app, then tell Silas.",
        "done": "You can explain why your automation is safe to run again."
      }
    }
  ],
