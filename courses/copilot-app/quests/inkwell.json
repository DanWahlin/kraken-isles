  "island": "inkwell",
  "tracker": {
    "chapter": "Chapter 06 · Canvases",
    "goal": "Keep the work on one shared board, and earn the Seal of Inkwell",
    "next": "Tidewheel Caldera is next, and she’s still being charted. Until then these waters are yours.",
    "nextSail": "Tidewheel Caldera is next. Board your ship and follow the compass south."
  },
  "quests": [
    {
      "id": "Q6.1",
      "title": "The Band’s Arrangement Board",
      "task": "Hear the Bard’s tale",
      "steps": {
        "start": "Lyra’s playing at the taverna, along the lane from the quay.",
        "done": "A long group chat buries decisions. A canvas is the app’s arrangement board for you and the agent."
      }
    },
    {
      "id": "Q6.2",
      "title": "The Gossip Stair",
      "task": "Tell a thread from a board",
      "steps": {
        "start": "Thea keeps the Washing Square, up the first flight of the Gossip Stair.",
        "done": "Chat for a quick answer to a short task. A canvas when there’s state to keep visible, steps that repeat, or controls you both use."
      }
    },
    {
      "id": "Q6.3",
      "title": "The Four Desks",
      "task": "Make ready, and note your baseline",
      "link": {
        "label": "Prepare the session in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#prerequisites"
      },
      "steps": {
        "start": "Nikos keeps the desks on the Plaza, at the top of the stair.",
        "done": "Plan, Terminal, Browser and Changes come with every session. Your test totals are the baseline."
      }
    },
    {
      "id": "Q6.4",
      "title": "The Borrowed Board",
      "task": "Try a community canvas",
      "link": {
        "label": "Install the canvas in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#exercise-1-try-your-first-canvas"
      },
      "steps": {
        "start": "Envoy Calla is in the Loggia, on the Plaza’s west side.",
        "board": "Work the Borrowed Board round the Loggia.",
        "solved": "Every lamp in the Loggia is lit. Talk to Calla.",
        "done": "The package has one name and the board another. Move one card to Plan, and the agent moves it to Ready."
      }
    },
    {
      "id": "Q6.5",
      "title": "Two Hands, One Chart",
      "task": "Create a Session Board",
      "link": {
        "label": "Create the board in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#exercise-2-create-a-session-board"
      },
      "steps": {
        "start": "Petra works on the Draughting Terrace, north of the Plaza.",
        "slate": "Work Two Hands, One Chart round the terrace.",
        "solved": "Every lamp on the terrace is lit. Talk to Petra.",
        "done": "You and the agent both read and update one board. It’s user-scoped: no repository files changed."
      }
    },
    {
      "id": "Q6.6",
      "title": "The Great Chart",
      "task": "Learn what the Feature Workbench holds",
      "link": {
        "label": "Create the workbench in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#exercise-3-create-a-feature-workbench"
      },
      "steps": {
        "start": "Doran keeps the Great Chart, along the Kite Walk.",
        "done": "Five stages and no Approve stage. Every button is an agent-callable action. Repair one part; never regenerate the whole."
      }
    },
    {
      "id": "Q6.7",
      "title": "The Shared Chart",
      "task": "Run the workbench from proposal to final checks",
      "link": {
        "label": "Run the workbench in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#exercise-3-create-a-feature-workbench"
      },
      "steps": {
        "start": "Talk to Doran again at the Great Chart.",
        "chart": "Walk the Shared Chart round the Chart Court.",
        "solved": "Every lamp in the court is lit. Talk to Doran.",
        "done": "Approve in the Plan tab, record a baseline first, and mark a stage only from recorded evidence."
      }
    },
    {
      "id": "Q6.8",
      "title": "The Trial of the Dome",
      "task": "Pass the Trial to earn the Seal",
      "steps": {
        "start": "Warden Iris waits on the Dome’s terrace, up the Dome Stair.",
        "exam": "The Trial of the Dome is ready when you are.",
        "done": "The Seal of Inkwell is yours."
      }
    },
    {
      "id": "Q6.A",
      "title": "Your Turn: An Assess Stage",
      "task": "Extend your workbench",
      "optional": true,
      "link": {
        "label": "Do the assignment in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/06-canvases/README.md#assignment"
      },
      "steps": {
        "start": "Iris has one more task, on the terrace.",
        "try": "Add the Assess stage in the app and run the workbench, then tell Iris.",
        "done": "Evidence at every stage, from assessment through local validation."
      }
    }
  ],
