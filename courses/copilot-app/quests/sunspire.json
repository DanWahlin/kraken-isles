  "notes": {
    "lyra": "The gear song (puzzles/gear-song.json, the ss-song cue): the players play from the chart and the singer can’t be heard; the player connects the gear and the song comes through (05 · from-the-studio-connecting-the-gear).",
    "zahra": "The weighing table (ss-scales) frames the matching quiz M5.1; then the least-tool principle.",
    "idris": "The well (ss-well): one well for every tent. A worktree separates file changes, not installed tools.",
    "noor.signal": "Starts Mirror Beams (puzzles/mirror-beams.json, P5.1) and frames the court (ss-signal).",
    "samir.crate": "Starts the Sealed Crate (puzzles/sealed-crate.json, P5.2) and frames the yard (ss-crate).",
    "trial.passed": "The Seal (ss-seal): the Sunspire lights, the court’s beam crosses to it and on to Library Rock, and the pennants unroll."
  },
  "barks": {
    "ss_player_a": [
      "One, two, and wait for the singer!",
      "The chart says what to play. It never said plug her in."
    ],
    "ss_player_b": [
      "I’ve played this tune forty years. I still read the chart.",
      "Loud enough now, Captain?"
    ],
    "ss_trader": [
      "Dates, figs, saffron! Take what you’ll eat, Captain, no more.",
      "A heavy pack is a slow caravan."
    ],
    "ss_weaver": [
      "Feel that weave, Captain. I check every thread myself.",
      "The label says silk. I look anyway."
    ],
    "ss_carrier": [
      "Water for the camp! One well, every tent.",
      "Mind the falaj, Captain. It’s shallow, but it’s cold."
    ],
    "ss_camper": [
      "My tent’s my own. The well’s everyone’s.",
      "Somebody added a second rope to the well. One was enough."
    ],
    "ss_signaller": [
      "Shutter open, and still no answer. Aim first, I say.",
      "We flash the question. We never flash the ledger."
    ],
    "ss_porter": [
      "Read the lading, then lift. In that order.",
      "A crate on the bench hasn’t done a day’s work yet."
    ],
    "ss_child": ["Look, look! I can flash the Sunspire with my mirror!", "The big tower winked at me!"],
    "ss_fisher": [
      "Morning light’s best for the mirrors, Captain.",
      "I watched that tower flash before you were born."
    ],
    "noor": [
      "Samir’s crates are in the yard, Captain, by the court’s east side.",
      "One beam to a tower. A second one only crosses the first."
    ],
    "samir": [
      "Up the Sun Stair, Captain. Paloma’s on the terrace.",
      "Read what’s inside before you take it in."
    ]
  }
}
