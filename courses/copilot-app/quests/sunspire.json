  "island": "sunspire",
  "tracker": {
    "chapter": "Chapter 05 · MCP Servers & Plugins",
    "goal": "Connect a server, open a plugin, and earn the Seal of Sunspire",
    "next": "Inkwell Bluffs is next, and she’s still being charted. Until then these waters are yours.",
    "nextSail": "Inkwell Bluffs is next. Board your ship and follow the compass south."
  },
  "quests": [
    {
      "id": "Q5.1",
      "title": "Connecting the Gear",
      "task": "Hear the Bard’s tale",
      "steps": {
        "start": "Lyra’s playing in the caravanserai, at the quay’s head.",
        "done": "An MCP server is a connection that gives the crew tools. A plugin is a package of additions. Check what’s inside before you enable it."
      }
    },
    {
      "id": "Q5.2",
      "title": "The Bazaar",
      "task": "Tell a server from a plugin",
      "steps": {
        "start": "Zahra keeps the scales on the bazaar square.",
        "done": "A server connects the app to a service. A plugin is a package you install. Add one only when the task needs it."
      }
    },
    {
      "id": "Q5.3",
      "title": "A Tent of Your Own",
      "task": "Start a practice session",
      "link": {
        "label": "Create the session in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/05-mcp-plugins/README.md#create-a-practice-session"
      },
      "steps": {
        "start": "Idris keeps the camp at the oasis, down from the square.",
        "done": "One session in a new worktree from main, kept for the whole chapter. A worktree separates files, not installed tools."
      }
    },
    {
      "id": "Q5.4",
      "title": "The Signal House",
      "task": "Learn what an MCP server is",
      "steps": {
        "start": "Signal Master Noor is at the Signal House, up the Signal Stair.",
        "done": "An MCP server supplies tools from a service. Use one when the task needs what the app’s own tools don’t supply."
      }
    },
    {
      "id": "Q5.5",
      "title": "Mirror Beams",
      "task": "Connect a server and check its answer",
      "link": {
        "label": "Add Context7 in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/05-mcp-plugins/README.md#exercise-check-the-book-apps-input-labels-with-context7"
      },
      "steps": {
        "start": "Talk to Noor again at the Signal House.",
        "signal": "Walk Mirror Beams round the Mirror Court.",
        "solved": "Every lamp in the court is lit. Talk to Noor.",
        "done": "Enabled isn’t connected. Ask the general question, check the tool activity and its sources, and compare at home."
      }
    },
    {
      "id": "Q5.6",
      "title": "Sealed Crates",
      "task": "Learn what a plugin is",
      "steps": {
        "start": "Samir trades in the Crate Yard, past the court.",
        "done": "A plugin packages skills, agents, servers or canvases. Installing it doesn’t run them. Read what’s inside first."
      }
    },
    {
      "id": "Q5.7",
      "title": "The Sealed Crate",
      "task": "Install a plugin and use its skill",
      "link": {
        "label": "Install the plugin in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/05-mcp-plugins/README.md#exercise-plan-a-css-improvement-with-modern-web-guidance"
      },
      "steps": {
        "start": "Talk to Samir again in the Crate Yard.",
        "crate": "Work the Sealed Crate round the yard.",
        "solved": "Every lamp in the yard is lit. Talk to Samir.",
        "done": "Read it, install it, reload, invoke its skill, and check its answer against the code."
      }
    },
    {
      "id": "Q5.8",
      "title": "The Trial of the Sunspire",
      "task": "Pass the Trial to earn the Seal",
      "steps": {
        "start": "Warden Paloma waits on the Sundial Terrace, up the Sun Stair.",
        "exam": "The Trial of the Sunspire is ready when you are.",
        "done": "The Seal of Sunspire is yours."
      }
    },
    {
      "id": "Q5.A",
      "title": "Your Turn: The Evidence Table",
      "task": "Summarize the evidence",
      "optional": true,
      "link": {
        "label": "Do the assignment in the app ↗",
        "url": "https://github.com/github/copilot-app-for-beginners/blob/main/05-mcp-plugins/README.md#assignment"
      },
      "steps": {
        "start": "Paloma has one more task, on the terrace.",
        "try": "Make your evidence table in the app, then tell Paloma.",
        "done": "Completed work apart from proposed checks, with a real source for each tool."
      }
    }
  ],
